# ============================================================
# Dockerfile.inference — Contenedor optimizado para modelos predictivos
# ============================================================
# Incluye: ML pipeline (XGBoost + scikit-learn + SMOTE)
# Optimizado para CPU. Para GPU, cambiar a imagen con CUDA base.

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Solo las dependencias ML necesarias (imagen más liviana)
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir \
    scikit-learn==1.5.2 \
    xgboost==2.1.3 \
    imbalanced-learn==0.12.4 \
    pandas==2.2.3 \
    numpy==1.26.4 \
    joblib==1.4.2 \
    sqlalchemy==2.0.36 \
    asyncpg==0.30.0 \
    psycopg2-binary==2.9.10 \
    alembic==1.14.0 \
    python-dotenv==1.0.1 \
    pydantic==2.10.3

COPY platform/backend/ ./

# Directorio de modelos (montar como volumen en producción)
VOLUME ["/app/ml/models"]

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import joblib; joblib.load('ml/models/best_model.pkl'); print('ok')" || exit 1

# Corre predicción batch — se ejecuta como job, no como servidor
CMD ["python", "-m", "ml.predict"]
