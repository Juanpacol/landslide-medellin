# =========================================================================
# DOCKER (docker compose up): NO necesitas tocar nada. El compose ya define
# valores por defecto sensatos. Estas variables solo aplican si corres los
# servicios a mano (sin Docker) o quieres sobrescribir los defaults del compose.
# =========================================================================

# --- Base de datos (PostgreSQL) ---
# LOCAL (Docker): DATABASE_URL=postgresql+asyncpg://teyva:teyva@db:5432/teyva
# SUPABASE (nube): DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:Meliodas9341.@db.snonfhqtdqlaxmyxkcrd.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:Meliodas9341.@db.snonfhqtdqlaxmyxkcrd.supabase.co:5432/postgres
# TLS: false para local/Docker; true para Supabase (requiere HTTPS).
DB_SSL=true

# --- Credenciales del contenedor PostgreSQL (solo Docker) ---
POSTGRES_USER=teyva
POSTGRES_PASSWORD=teyva
POSTGRES_DB=teyva

# --- pgAdmin (interfaz visual para PostgreSQL, accesible en http://localhost:5050) ---
PGADMIN_EMAIL=admin@teyva.dev
PGADMIN_PASSWORD=teyva

# --- Seguridad de la API ---
# Orígenes permitidos para CORS (separados por coma). Vacío = localhost dev.
ALLOWED_ORIGINS=http://localhost:3000
# Token para endpoints críticos (/predict-all, /predict-commune).
# Vacío = sin auth (solo dev). Definir en producción.
API_TOKEN=

# --- Agente conversacional (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b

# --- RAG + Tools (chatbot con base de conocimiento ChromaDB) ---
# ENABLE_RAG=true activa el chat con tool-calling (RAG en ChromaDB + consultas
# a la BD). false = chat clásico de respuesta-única. Requiere ingestar antes:
#   python -m rag.chroma_store --ingest
ENABLE_RAG=false
# Modelo de embeddings multilingüe (se descarga ~470MB la primera vez).
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Modelo que orquesta las tools (local). Debe soportar tool-calling (llama3.2 sí).
RAG_CHAT_MODEL=llama3.2
# Máximo de rondas modelo→tools→modelo por pregunta.
RAG_MAX_TOOL_ROUNDS=3

# --- Risk Explanations (GPT-4 Mini via OpenRouter) ---
# Sin esta key el sistema genera explicaciones con template determinístico (sin costo).
# Con la key activa usa GPT-4 Mini + tool use para explicaciones enriquecidas.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Alertas Slack ---
# Webhook (texto): el canal recibe alertas enriquecidas con sparkline + links.
# Configurable también vía UI (se guarda en app_settings.slack_webhook_url).
SLACK_WEBHOOK_URL=
# Bot token (xoxb-...) + canal: habilita SUBIR la gráfica PNG inline en el mensaje.
# Sin esto, las alertas usan webhook con sparkline ASCII + botón "Ver gráfica".
# Scopes requeridos: files:write, chat:write. Channel ID tipo C0XXXXXXX.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# URLs públicas para los botones de la alerta.
DASHBOARD_URL=http://localhost:3000
CHART_BASE_URL=http://localhost:8000

# --- Legacy (ETL Supabase, pendiente de migrar a PostgreSQL) ---
SUPABASE_URL=
SUPABASE_KEY=
