# =========================================================================
# DOCKER (docker compose up): NO necesitas tocar nada. El compose ya define
# valores por defecto sensatos. Estas variables solo aplican si corres los
# servicios a mano (sin Docker) o quieres sobrescribir los defaults del compose.
# =========================================================================

# --- Base de datos (PostgreSQL) ---
# SUPABASE (default): usar el Connection Pooler en modo Session (puerto 5432).
# El host directo db.<ref>.supabase.co es IPv6-only y NO resuelve en muchas redes;
# el pooler (aws-X-<region>.pooler.supabase.com) sí tiene IPv4.
# Dashboard Supabase → Settings → Database → Connection Pooling.
# LOCAL (offline): DATABASE_URL=postgresql+asyncpg://teyva:teyva@db:5432/teyva y DB_SSL=false.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<TU_PASSWORD>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.<PROJECT_REF>:<TU_PASSWORD>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# TLS: false para local/Docker; true para Supabase (requiere TLS).
DB_SSL=true

# --- Credenciales del contenedor PostgreSQL (solo Docker) ---
POSTGRES_USER=teyva
POSTGRES_PASSWORD=teyva
POSTGRES_DB=teyva

# --- pgAdmin (interfaz visual para PostgreSQL, accesible en http://localhost:5050) ---
PGADMIN_EMAIL=admin@teyva.dev
PGADMIN_PASSWORD=teyva

# --- Seguridad de la API ---
# Orígenes permitidos para CORS (separados por coma). Vacío = localhost dev.
ALLOWED_ORIGINS=http://localhost:3000
# Token para endpoints críticos (/predict-all, /predict-commune).
# Vacío = sin auth (solo dev). Definir en producción.
API_TOKEN=

# --- Agente conversacional: Claude (primario) + Ollama (fallback local) ---
# LLM_PROVIDER=anthropic (default): usa la API de Claude. Si falta
# ANTHROPIC_API_KEY o la llamada falla, cae automáticamente a Ollama.
# LLM_PROVIDER=ollama: fuerza Ollama directamente (útil sin conexión).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Fallback local (se usa solo si LLM_PROVIDER=ollama o si Claude falla).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- RAG + Tools (chatbot con base de conocimiento ChromaDB) ---
# ENABLE_RAG=true activa el chat con tool-calling (RAG en ChromaDB + consultas
# a la BD). false = chat clásico de respuesta-única. Requiere ingestar antes:
#   python -m rag.chroma_store --ingest
ENABLE_RAG=true
# Modelo de embeddings multilingüe (se descarga ~470MB la primera vez).
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Máximo de rondas modelo→tools→modelo por pregunta.
RAG_MAX_TOOL_ROUNDS=3

# --- Risk Explanations (Claude, misma API/key de arriba) ---
# Sin ANTHROPIC_API_KEY el sistema genera explicaciones con template
# determinístico (sin costo). Con la key activa usa Claude + tool use +
# salida JSON estructurada para explicaciones enriquecidas.

# --- Alertas Slack ---
# Webhook (texto): el canal recibe alertas enriquecidas con sparkline + links.
# Configurable también vía UI (se guarda en app_settings.slack_webhook_url).
SLACK_WEBHOOK_URL=
# Bot token (xoxb-...) + canal: habilita SUBIR la gráfica PNG inline en el mensaje.
# Sin esto, las alertas usan webhook con sparkline ASCII + botón "Ver gráfica".
# Scopes requeridos: files:write, chat:write. Channel ID tipo C0XXXXXXX.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# URLs públicas para los botones de la alerta.
DASHBOARD_URL=http://localhost:3000
CHART_BASE_URL=http://localhost:8000

# --- Legacy (ETL Supabase, pendiente de migrar a PostgreSQL) ---
SUPABASE_URL=
SUPABASE_KEY=
